# Required for the Mailyte live provider.
MAILYTE_API_KEY=

# Set to live to enable Mailyte without switching other providers to live.
MAILYTE_MODE=

# Public measurement IDs; set these in Netlify environment variables for builds.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Escolha mock/live também no navegador (carrinho, vale-presente). Use o mesmo valor de PROVIDERS.
NEXT_PUBLIC_PROVIDERS=

# Liga só algumas partes em live (lista separada por vírgula); PROVIDERS=live continua ligando tudo.
# Servidor: catalog, cart, account, pets, subscription, reviews, forms, labs, campaign, content,
# email-preferences, gift-card, offers, store-locator, wholesale, mailyte. Nome errado interrompe o build.
PROVIDERS_LIVE=
# Navegador: cart, gift-card.
# O carrinho live (NEXT_PUBLIC_PROVIDERS_LIVE=cart ou NEXT_PUBLIC_PROVIDERS=live)
# requer catálogo live (PROVIDERS_LIVE=catalog ou PROVIDERS=live) para variantes e planos válidos.
NEXT_PUBLIC_PROVIDERS_LIVE=

# Shopify Storefront credentials for client-side LiveCartProvider (browser)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
