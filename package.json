{
  "name": "nadeon-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "data:check": "node scripts/check-placeholders.mjs && node scripts/data-check.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "tokens:audit": "node scripts/design-audit.mjs",
    "security:audit": "pnpm audit --audit-level=high --ignore GHSA-2464-fhr4-w9xw --ignore GHSA-673q-mjm6-r5xr --ignore GHSA-p3m5-59mp-jv5r",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm tokens:check && pnpm data:check",
    "gate": "pnpm verify && pnpm build"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@next/mdx": "^16.4.6",
    "@shopify/hydrogen-react": "^2026.4.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "next": "16.3.8",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.92.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
